# Gemini API key (https://aistudio.google.com/apikey) — server-side only
GEMINI_API_KEY=your-gemini-api-key
# Optional: override model (default gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
# Web App URL of the deployed Apps Script (apps-script/Code.gs)
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXX/exec
# Shared secret; must match SECRET in apps-script/Code.gs
FORM_SECRET=change-me
# Optional fallback/primary AI provider (free key: https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key
